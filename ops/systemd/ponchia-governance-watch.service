[Unit]
Description=Read-only Ponchia GitHub governance drift check
Documentation=https://github.com/Ponchia/.github/blob/main/docs/REPOSITORY_POLICY.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/ponchia-governance/repo
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=GH_PROMPT_DISABLED=1
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=600
ExecStartPre=/usr/bin/git -C %h/.local/share/ponchia-governance/repo pull --ff-only --quiet
ExecStart=/usr/bin/python3 %h/.local/share/ponchia-governance/repo/scripts/governance_v2.py watch --notify issue
